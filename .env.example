# Copy this file to .env and fill in the values

# MySQL DSN: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=root:password@tcp(localhost:3306)/tododb?charset=utf8mb4&parseTime=True&loc=Local

# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=troque-por-uma-chave-secreta-muito-longa-e-aleatoria

# Port the server will listen on
PORT=8080
